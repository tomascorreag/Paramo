[internationalization]

locale/translations=PackedStringArray("res://assets/translations/paramo.en_GB.translation", "res://assets/translations/paramo.es_CO.translation")
locale/fallback="en_GB"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.0784314, 0.137255, 0.227451, 1)

[shader_globals]

water_disp_scroll={
"type": "vec2",
"value": Vector2(-0.5, 1)
}
water_disp_scale={
"type": "vec2",
"value": Vector2(0.05, 0.1)
}
shader_debug={
"type": "int",
"value": 0
}
wind_lean={
"type": "float",
"value": 0.0
}
wind_gust={
"type": "float",
"value": 0.0
}
world_time={
"type": "float",
"value": 0.0
}
