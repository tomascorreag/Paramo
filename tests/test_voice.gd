extends GutTest

# The coordinator's mumble voice (scripts/systems/voice/).
#
# Parity: VoicePlan is a port of voice_lab/js. The lab is where the voice was tuned
# by ear, so the game must say exactly what the lab says. The fixture holds the lab's
# plan for every line the coordinator can say (both locales, every species x every
# inspect phrasing, the FTUE narrative) and is regenerated by
#   node voice_lab/tools/make_fixture.mjs
# A failure here means the two front ends drifted: fix the port, or change the lab
# and re-run the tool.
#
# Synth: tract-lite renders finite, audible, bounded audio, fast enough to stream.

const FIXTURE_PATH: String = "res://tests/fixtures/voice_plan_fixture.json"
const PROFILE: VoiceProfile = preload("res://resources/voices/coordinator.tres")


func _fixture_cases() -> Array:
	var text := FileAccess.get_file_as_string(FIXTURE_PATH)
	assert_true(text != "", "fixture missing: run node voice_lab/tools/make_fixture.mjs")
	var data: Dictionary = JSON.parse_string(text)
	return data["cases"]


func test_plan_matches_lab_for_every_voiced_line() -> void:
	var cases := _fixture_cases()
	assert_gt(cases.size(), 100, "fixture covers every voiced line")
	var mismatches: Array[String] = []
	for c: Dictionary in cases:
		var plan := VoicePlan.build(c["text"], StringName(c["lang"]), PROFILE)
		var why := _diff(plan, c)
		if why != "":
			mismatches.append("%s [%s]: %s" % [c["text"], c["lang"], why])
	assert_eq(mismatches.size(), 0, "\n".join(mismatches.slice(0, 8)))


func _diff(plan: VoicePlan, c: Dictionary) -> String:
	var segs: Array = c["segments"]
	if plan.segments.size() != segs.size():
		return "segments %d vs lab %d: %s" % [plan.segments.size(), segs.size(), _syms(plan)]
	for i in segs.size():
		if String(plan.segments[i][&"sym"]) != segs[i][0]:
			return "segment %d is %s, lab %s: %s" % [i, plan.segments[i][&"sym"], segs[i][0], _syms(plan)]
		if absf(float(plan.segments[i][&"dur"]) - float(segs[i][1])) > 1e-6:
			return "segment %d lasts %.6f, lab %.6f" % [i, plan.segments[i][&"dur"], segs[i][1]]
	var stressed: Array = c["stressed"]
	for i in stressed.size():
		if int(plan.syllables[i][&"stressed"]) != int(stressed[i]):
			return "syllable %d stress differs" % i
	var types: Array = c["phrases"]
	for i in types.size():
		if String(plan.phrases[i][&"type"]) != types[i]:
			return "phrase %d is %s, lab %s" % [i, plan.phrases[i][&"type"], types[i]]
	var f0s: Array = c["f0"]
	for i in f0s.size():
		var hz := plan.f0[i * 4]
		if absf(hz - float(f0s[i])) > 0.02:
			return "f0 at frame %d is %.2f Hz, lab %.2f" % [i * 4, hz, f0s[i]]
	return ""


func _syms(plan: VoicePlan) -> String:
	var out: PackedStringArray = []
	for s: Dictionary in plan.segments:
		out.append(String(s[&"sym"]))
	return " ".join(out)


func test_spanish_rules() -> void:
	var t := VoiceG2P.tokenize("¿Quieres plantar frailejones?", &"es")
	var words: PackedStringArray = []
	for tok: Dictionary in t:
		if tok[&"type"] == &"word":
			var syms: PackedStringArray = []
			for p: Dictionary in tok[&"phones"]:
				syms.append(String(p[&"sym"]))
			words.append(" ".join(syms))
	assert_eq(" | ".join(words), "k j e r e s | p l a n t a r | f r a j l e x o n e s")


func test_english_is_non_rhotic() -> void:
	var t := VoiceG2P.tokenize("car", &"en")
	var syms: PackedStringArray = []
	for p: Dictionary in t[0][&"phones"]:
		syms.append(String(p[&"sym"]))
	assert_eq(" ".join(syms), "k aa")


func test_synth_renders_bounded_audible_audio() -> void:
	var plan := VoicePlan.build("¡Un frailejón!", &"es", PROFILE)
	var synth := VoiceSynth.new()
	synth.start(plan, PROFILE)
	var out := PackedFloat32Array()
	var guard := 0
	while not synth.is_finished() and guard < 1000:
		synth.fill(out, 512)
		guard += 1
	assert_true(synth.is_finished(), "line ends")
	var expected := (plan.duration + VoiceSynth.REVERB_TAIL) * PROFILE.tract_rate()
	assert_almost_eq(float(out.size()), expected, PROFILE.tract_rate() * 0.02, "length = plan + reverb tail")
	var peak := 0.0
	var energy := 0.0
	var non_finite := 0
	for x in out:
		if is_nan(x) or is_inf(x):
			non_finite += 1
			continue
		peak = maxf(peak, absf(x))
		energy += x * x
	assert_eq(non_finite, 0, "every sample finite")
	assert_lte(peak, 1.0, "soft ceiling holds")
	# Measured before output_gain, which is a mix level set by ear, not a synth property.
	assert_gt(sqrt(energy / out.size()) / PROFILE.output_gain, 0.02, "the synth makes sound")


# Not a benchmark (desktop CI numbers mean little for the web build), a tripwire:
# the voice must stay well under real time or it can't stream.
func test_synth_is_well_under_real_time() -> void:
	var plan := VoicePlan.build("Te damos la bienvenida al páramo. Esta tierra y su agua son sagradas.", &"es", PROFILE)
	var synth := VoiceSynth.new()
	var t0 := Time.get_ticks_usec()
	synth.start(plan, PROFILE)
	var out := PackedFloat32Array()
	while not synth.is_finished():
		synth.fill(out, 4096)
	var seconds_audio := out.size() / PROFILE.tract_rate()
	var ms_per_second := (Time.get_ticks_usec() - t0) / 1000.0 / seconds_audio
	gut.p("tract-lite: %.1f ms of GDScript per second of speech" % ms_per_second)
	assert_lt(ms_per_second, 300.0, "streamable")
