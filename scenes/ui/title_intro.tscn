[gd_scene load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/ui/title_intro.gd" id="1_ti_script"]
[ext_resource type="Texture2D" path="res://assets/sprites/Titles/MainTitle_animated.png" id="2_ti_anim"]
[ext_resource type="Theme" path="res://resources/ui/paramo_theme.tres" id="3_ti_theme"]
[ext_resource type="StyleBox" path="res://resources/ui/styleboxes/frame_border.tres" id="4_ti_frame"]
[ext_resource type="Texture2D" path="res://assets/sprites/UX/icons/flag_colombia.tres" id="5_ti_flag_co"]
[ext_resource type="Texture2D" path="res://assets/sprites/UX/icons/flag_uk.tres" id="6_ti_flag_uk"]

[node name="TitleIntro" type="CanvasLayer"]
layer = 200
script = ExtResource("1_ti_script")
animated_texture = ExtResource("2_ti_anim")

[node name="Curtain" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
; Authored transparent so it doesn't blanket the viewport in the editor. At
; runtime title_intro.gd _ready sets color = color_a (opaque) and drives the
; fade via modulate.a, so this alpha is editor-only. RGB mirrors color_a's
; default (palette P30).
color = Color(0.0784314, 0.137255, 0.227451, 0)

[node name="Title" type="TextureRect" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -128.0
offset_top = -32.0
offset_right = 128.0
offset_bottom = 32.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

; The language gate. Replaces the old "click to begin" prompt: picking a box IS
; the begin click, and it also sets the locale (see title_intro.gd _choose).
; Both boxes carry LITERAL text, never a translation key — each label is written
; in the language it selects, which is the whole point of showing them together.
; Box order and the strings themselves come from LocaleManager.SUPPORTED; the
; script rewrites them in _ready so the scene and that list cannot drift.
[node name="LanguageChoice" type="HBoxContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -108.0
offset_top = 40.0
offset_right = 108.0
offset_bottom = 96.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("3_ti_theme")
theme_override_constants/separation = 8
alignment = 1

; Two-node fill + frame pattern (see CLAUDE.md UI Architecture): the Panel takes
; its solid fill from the global theme, the Frame child overlays the hollow
; outline. Copied inline rather than instancing framed_panel.tscn so the labels
; stay directly editable in this scene.
[node name="Box0" type="Panel" parent="LanguageChoice"]
custom_minimum_size = Vector2(100, 56)
layout_mode = 2
mouse_filter = 2

[node name="Frame" type="Panel" parent="LanguageChoice/Box0"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
theme_override_styles/panel = ExtResource("4_ti_frame")

[node name="Stack" type="VBoxContainer" parent="LanguageChoice/Box0"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
theme_override_constants/separation = 4
alignment = 1

[node name="Name" type="Label" parent="LanguageChoice/Box0/Stack"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.996, 0.882, 0.722, 1)
theme_override_font_sizes/font_size = 16
text = "español"
horizontal_alignment = 1
vertical_alignment = 1

; Region flag under the language name. Authored so the editor shows the real
; icon, but the script re-assigns it from LocaleManager.SUPPORTED's `flag` path
; in _ready, same as the Name text — the scene and that list cannot drift.
[node name="Flag" type="TextureRect" parent="LanguageChoice/Box0/Stack"]
texture_filter = 1
layout_mode = 2
mouse_filter = 2
texture = ExtResource("5_ti_flag_co")
stretch_mode = 5

[node name="Box1" type="Panel" parent="LanguageChoice"]
custom_minimum_size = Vector2(100, 56)
layout_mode = 2
mouse_filter = 2

[node name="Frame" type="Panel" parent="LanguageChoice/Box1"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
theme_override_styles/panel = ExtResource("4_ti_frame")

[node name="Stack" type="VBoxContainer" parent="LanguageChoice/Box1"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
theme_override_constants/separation = 4
alignment = 1

[node name="Name" type="Label" parent="LanguageChoice/Box1/Stack"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.996, 0.882, 0.722, 1)
theme_override_font_sizes/font_size = 16
text = "english"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Flag" type="TextureRect" parent="LanguageChoice/Box1/Stack"]
texture_filter = 1
layout_mode = 2
mouse_filter = 2
texture = ExtResource("6_ti_flag_uk")
stretch_mode = 5
