[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="1_hud"]
[ext_resource type="Texture2D" path="res://assets/sprites/UX/icons/frailejon.tres" id="2_icon"]
[ext_resource type="Texture2D" path="res://assets/sprites/UX/icons/season_wheel.tres" id="3_wheel"]

; Stepped (constant-interpolation) glow rising from the slit, behind the wheel.
; Single palette colour (index 30 #14233A) fading to transparent over 4 hard
; bands → pixel-art look, no smooth ramp. interpolation_mode 1 = CONSTANT.
[sub_resource type="Gradient" id="Gradient_glow"]
interpolation_mode = 1
offsets = PackedFloat32Array(0, 0.33, 0.66, 1)
colors = PackedColorArray(0.078431, 0.137255, 0.227451, 0.85, 0.078431, 0.137255, 0.227451, 0.5, 0.078431, 0.137255, 0.227451, 0.22, 0.078431, 0.137255, 0.227451, 0)

[sub_resource type="GradientTexture2D" id="GradientTexture2D_glow"]
gradient = SubResource("Gradient_glow")
width = 8
height = 32
fill_from = Vector2(0, 1)
fill_to = Vector2(0, 0)

; Frames are built in code (see hud.gd::_frame_stylebox). Marker fills below
; use palette2.aseprite index 12 (#FDD179). Alpha stays 1 here.

; layer 110 sits ABOVE PostProcessLayer (layer 100, hint_screen_texture grading +
; vignette) in gameplay_base, so HUD elements render on top of the post-process
; and stay un-graded / un-vignetted regardless of time of day.
[node name="HUD" type="CanvasLayer"]
layer = 110
script = ExtResource("1_hud")

; Glow behind the gauge — listed before SeasonWheelMask so the wheel draws over
; it. Rises from the slit (bottom) and fades out above the dome; nearest filter
; keeps the gradient's bands crisp when stretched.
[node name="WheelGlow" type="TextureRect" parent="."]
texture_filter = 1
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 2.0
offset_top = -50.0
offset_right = 74.0
offset_bottom = -6.0
grow_vertical = 0
mouse_filter = 2
texture = SubResource("GradientTexture2D_glow")
expand_mode = 1

; Half-dome season gauge, bottom-left. The mask clips to its top half (64x32);
; the 64x64 wheel inside rotates around the mask's bottom-center (32,32), so only
; the top semicircle shows and the current season's weather rides the top.
[node name="SeasonWheelMask" type="Control" parent="."]
unique_name_in_owner = true
clip_contents = true
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 6.0
offset_top = -38.0
offset_right = 70.0
offset_bottom = -6.0
grow_vertical = 0
mouse_filter = 2

[node name="SeasonWheel" type="TextureRect" parent="SeasonWheelMask"]
unique_name_in_owner = true
texture_filter = 1
offset_right = 64.0
offset_bottom = 64.0
mouse_filter = 2
texture = ExtResource("3_wheel")
expand_mode = 1
stretch_mode = 5

; Slot lip the wheel appears inserted into. Long, thin, dark (palette2 index 30
; #14233A — the darkest entry); drawn AFTER the mask so it overlaps the wheel's
; flat bottom edge and reads as a slit the semicircle emerges from.
[node name="WheelSlit" type="ColorRect" parent="."]
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 2.0
offset_top = -8.0
offset_right = 74.0
offset_bottom = -5.0
grow_vertical = 0
mouse_filter = 2
color = Color(0.078431, 0.137255, 0.227451, 1)

