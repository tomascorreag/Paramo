offset_left = 6.0
offset_top = 12.0
offset_right = 70.0
offset_bottom = 44.0
mouse_filter = 2

[node name="SeasonWheel" type="TextureRect" parent="Book/Pages/SeasonGaugeHolder/SeasonWheelMask"]
unique_name_in_owner = true
texture_filter = 1
