offset_top = 50.0
offset_right = 425.0
offset_bottom = 230.0
mouse_filter = 2
theme_override_colors/font_color = Color(0.078431, 0.137255, 0.227451, 1)
theme_override_font_sizes/font_size = 8
text = "—"
autowrap_mode = 2
