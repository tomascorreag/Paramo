offset_left = 2.0
offset_top = 0.0
offset_right = 74.0
offset_bottom = 44.0
mouse_filter = 2
texture = SubResource("GradientTexture2D_glow")
expand_mode = 1

[node name="SeasonWheelMask" type="Control" parent="Book/Pages/SeasonGaugeHolder"]
